# CodePlay Studios — environment variables
#
# Copy to `.env` (or `.env.local`) for local dev. `.env*` is gitignored.
# NEVER commit real secrets. VITE_-prefixed vars are the ONLY ones baked
# into the browser bundle — keep every secret un-prefixed.

# ─────────────────────────────────────────────────────────────────────────
# Existing — image/video Tools backend (FastAPI, api.codeplaystudios.com)
# ─────────────────────────────────────────────────────────────────────────
# Build-time only. Set in the GitHub Actions build step for production.
VITE_TOOLS_API_URL=http://127.0.0.1:8001

# ─────────────────────────────────────────────────────────────────────────
# CodePlay Insights. See docs/codeplay-insights-database.md.
# Phase 2 uses the VITE_SUPABASE_* pair + the DB. The rest is Phase 3.
# ─────────────────────────────────────────────────────────────────────────

# --- Client-safe (VITE_-prefixed; admin auth + optional live reads, always
#     under Supabase Row Level Security). When both are empty the Insights
#     admin page reports "not configured" and supabase-js is tree-shaken. ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server / CI only. MUST NOT be VITE_-prefixed. Used by the Phase 3
#     content build step (GitHub Actions), the cron publish job, and the
#     ingestion/generation worker. ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string for `supabase db push` / psql migrations.
SUPABASE_DB_URL=

# Google Gemini — research notes, article drafting, QC (server/CI only).
# NOTE: image generation (GEMINI_IMAGE_MODEL) needs a *billed* Google project;
# the free tier cannot generate images and every article falls back.
GEMINI_API_KEY=
# Model IDs are configurable; real defaults live in
# insights-engine/src/config.ts. Leave blank to use them.
GEMINI_TEXT_MODEL=
GEMINI_FAST_MODEL=
GEMINI_IMAGE_MODEL=

# Pexels (https://www.pexels.com/api/) — free stock-photo fallback used when
# Gemini image generation fails or is filtered. Optional; without it the
# pipeline drops straight to the category SVG.
PEXELS_API_KEY=C6T8Cr1RP0sLcncgf2n0zbdSaGDtSUf6MANwnITLfeqCRFa02vZUDi31

# Supabase Storage bucket for generated featured images (Phase 5).
INSIGHTS_MEDIA_BUCKET=insights-media

# Admin allowlist — comma-separated emails permitted into /admin/insights.
NEWS_ADMIN_EMAIL=

# Shared bearer token protecting HTTP-triggered pipeline endpoints
# (ingestion / generation / publish jobs).
CRON_SECRET=

# --- Discovery engine (Phase 3), server / CI only ---
# GitHub API token for the releases adapter (Actions provides github.token
# automatically; only needed for local runs).
GITHUB_TOKEN=
# Optional — enables the Reddit community-signal adapter (official API only).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# CodePlay Insights — SEO / analytics / monetization (Phase 8).
# All VITE_-prefixed here ARE meant to ship in the HTML (a GA4 id, an
# AdSense publisher id, an on/off flag, a Search Console token — none are
# secrets). When unset, the corresponding feature renders nothing.
# ─────────────────────────────────────────────────────────────────────────

# Google Analytics 4 measurement id, e.g. "G-XXXXXXXXXX". Unset = no GA,
# no third-party script requested. Reuses an existing gtag if present.
VITE_GA4_ID=

# Google AdSense. Ads stay dormant until BOTH are set AND approval exists.
VITE_ADSENSE_CLIENT=
# Flip to "true" only after AdSense approves the site.
VITE_ADSENSE_ENABLED=

# Google Search Console meta-tag verification token (the value only, not
# the whole tag). Optional — DNS or the HTML-file method also work.
VITE_GSC_VERIFICATION=
