# CodePlay marketing site — single-page app (wouter client-side routing).
# Deployed to LiteSpeed shared hosting via FTP (see .github/workflows/main.yml).

# Never serve an auto-generated directory listing. Without this, /insights/
# (a real folder that only holds rss.xml) renders as "Index of /insights/"
# instead of falling through to the SPA.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /tools now lives at wipeclip.co (see client/src/lib/toolsLink.tsx). A
  # real 301 here means crawlers and no-JS clients get sent straight there
  # instead of hitting a 200 SPA shell that only redirects via JS.
  RewriteRule ^tools(/.*)?$ https://wipeclip.co$1 [R=301,L]

  # Real files (index.html, /assets/*, /insights/rss.xml, sitemap*.xml,
  # robots.txt, …) are served as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -l
  RewriteRule ^ - [L]

  # App Privacy Policies (direct static serving for clean URLs)
  RewriteRule ^colorbloom/privacy-policy/?$ colorbloom/privacy-policy/index.html [L]
  RewriteRule ^colorbloom-privacy-policy/?$ colorbloom-privacy-policy.html [L]

  # Everything else — including paths that collide with a real directory
  # such as /insights and /insights/ — is handed to the SPA entry point.
  RewriteRule ^ /index.html [L]
</IfModule>

# Long-cache the fingerprinted build assets.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|gif|svg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
