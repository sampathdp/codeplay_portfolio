# CodePlay marketing site — single-page app (wouter client-side routing).
# Deployed to LiteSpeed shared hosting via FTP (see .github/workflows/main.yml).

# Never serve an auto-generated directory listing. Without this, /insights/
# (a real folder that only holds rss.xml) renders as "Index of /insights/"
# instead of falling through to the SPA.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /tools now lives at wipeclip.co (see client/src/lib/toolsLink.tsx). A
  # real 301 here means crawlers and no-JS clients get sent straight there
  # instead of hitting a 200 SPA shell that only redirects via JS.
  RewriteRule ^tools(/.*)?$ https://wipeclip.co$1 [R=301,L]

  # Real files (index.html, /assets/*, /insights/rss.xml, sitemap*.xml,
  # robots.txt, …) are served as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -l
  RewriteRule ^ - [L]

  # Published articles get a prerendered /insights/<slug>/index.html (see
  # insights-engine/src/publish/prerender.ts) so crawlers/unfurlers that
  # don't run JS still see real title/description/OG/JSON-LD tags. Only
  # matches a single path segment after /insights/, so /insights/category/*,
  # /insights/search, /insights/tag/*, and the hub itself are untouched and
  # fall through to the SPA below as before.
  RewriteCond %{DOCUMENT_ROOT}/insights/$1/index.html -f
  RewriteRule ^insights/([^/]+)/?$ /insights/$1/index.html [L]

  # Everything else — including paths that collide with a real directory
  # such as /insights and /insights/ — is handed to the SPA entry point.
  RewriteRule ^ /index.html [L]
</IfModule>

# Long-cache the fingerprinted build assets.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|gif|svg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # No CDN sits in front of this host yet — s-maxage/stale-while-revalidate
  # are no-ops until one is added, but browsers do honor SWR, and the
  # header is ready for a future Cloudflare/edge layer with no further change.
  <FilesMatch "\.(html|xml)$">
    Header set Cache-Control "public, max-age=0, s-maxage=60, stale-while-revalidate=120"
  </FilesMatch>
</IfModule>
