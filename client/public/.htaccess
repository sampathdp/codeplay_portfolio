  # Everything else — including paths that collide with a real directory
  # such as /insights and /insights/ — is handed to the SPA entry point.
  RewriteRule ^ /index.html [L]
</IfModule>

# Long-cache the fingerprinted build assets.
<IfModule mod_headers.c>
  # Baseline security headers. No Content-Security-Policy on purpose: GA4,
  # AdSense, Supabase and inline JSON-LD need a carefully tested policy.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  <FilesMatch "\.(js|css|woff2?|png|jpe?g|gif|svg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # No CDN sits in front of this host yet — s-maxage/stale-while-revalidate
  # are no-ops until one is added, but browsers do honor SWR, and the
  # header is ready for a future Cloudflare/edge layer with no further change.
  <FilesMatch "\.(html|xml)$">
    Header set Cache-Control "public, max-age=0, s-maxage=60, stale-while-revalidate=120"
  </FilesMatch>
</IfModule>
