{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n frontend,tools-api -c blue,green \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "node scripts/dev-backend.mjs",
    "build": "vite build",
    "optimize:images": "node scripts/optimize-images.mjs",
    "preview": "vite preview",
    "check": "tsc",
    "check:engine": "tsc -p tsconfig.engine.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "insights:discover": "tsx --env-file-if-exists=.env insights-engine/src/run.ts discover",
    "insights:discover:dry": "tsx --env-file-if-exists=.env insights-engine/src/run.ts discover --dry-run --select",
    "insights:schedule": "tsx --env-file-if-exists=.env insights-engine/src/run.ts schedule",
    "insights:generate": "tsx --env-file-if-exists=.env insights-engine/src/generation/run.ts",
    "insights:seo": "tsx --env-file-if-exists=.env insights-engine/src/publish/run.ts",
    "insights:prerender": "tsx --env-file-if-exists=.env insights-engine/src/publish/prerender.ts",
    "insights:indexnow": "tsx --env-file-if-exists=.env insights-engine/src/publish/indexnow.ts",
    "insights:gsc": "tsx --env-file-if-exists=.env insights-engine/src/publish/gsc-submit.ts"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.4",
